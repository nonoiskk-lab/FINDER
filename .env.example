# Copy to .env for local runs (never commit the real .env).
# gem-intel does not auto-load .env; export these or use `dotenv run --`.

# --- AI analysis (Claude) ---------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# --- Google Workspace (pick ONE of the three) --------------------------
# 1) Service account (recommended for the unattended daily job)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}
# ...or a path instead of inline JSON:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# 2) OAuth user credentials (personal Drive, no service account access)
# GOOGLE_OAUTH_TOKEN_JSON={"token": "...", "refresh_token": "...", ...}

# Where reports are filed / mirrored. All optional — omit to let the tool
# create/find the "GeM Tender Intelligence" folder itself.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SHARED_DRIVE_ID=
GOOGLE_SHEET_ID=

# --- Portal etiquette ---------------------------------------------------
# Included in the crawler's User-Agent so GeM's operators can reach you.
GEM_CONTACT_EMAIL=procurement@yourcompany.example
